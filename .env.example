# Variable contract only: no loader is implemented yet.
# Future backend explicitly loads root .env, process environment takes precedence.
NOMI_HOST=127.0.0.1
NOMI_PORT=8000
NOMI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Relative paths resolve from repository root.
NOMI_DATA_DIR=.local/nomi
NOMI_RETENTION_DAYS=30

# Required for chat; deliberately no provider/model/key defaults.
# BASE_URL is the complete API root, including /v1 if the provider requires it.
NOMI_LLM_BASE_URL=
NOMI_LLM_MODEL=
NOMI_LLM_API_KEY=
NOMI_LLM_TIMEOUT_SECONDS=60

# Real providers and their credentials are selected at V0.4; never invent keys.
NOMI_STT_PROVIDER=disabled
NOMI_TTS_PROVIDER=disabled
NOMI_STT_TIMEOUT_SECONDS=30
NOMI_TTS_TIMEOUT_SECONDS=30
NOMI_DEVICE_PROVIDER=null

# PUBLIC frontend variable: copy only this line into frontend/.env.local later.
# Never copy LLM or speech credentials into VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v0
