# Backend loads repository-root .env; process environment takes precedence.
# No values here are credentials. Default mock mode needs no .env file.
NOMI_HOST=127.0.0.1
NOMI_PORT=8000
NOMI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Explicit selection; never silently fall back from openai to mock.
NOMI_LLM_PROVIDER=mock
# Complete API root, including /v1 if required by the provider.
NOMI_LLM_BASE_URL=
NOMI_LLM_MODEL=
NOMI_LLM_API_KEY=
NOMI_LLM_TIMEOUT_SECONDS=60
NOMI_LLM_MAX_OUTPUT_TOKENS=1024
NOMI_LLM_JSON_MODE=false
NOMI_LLM_TOKEN_PARAMETER=max_tokens

# Current bounded, process-local context (no database yet).
NOMI_CONTEXT_MAX_TURNS=10
NOMI_CONTEXT_MAX_CHARS=16000
NOMI_MAX_SESSIONS=100
NOMI_SESSION_TTL_SECONDS=1800

# Future storage/voice/device settings below are not implemented or read in 2A.
NOMI_DATA_DIR=.local/nomi
NOMI_RETENTION_DAYS=30
NOMI_STT_PROVIDER=disabled
NOMI_TTS_PROVIDER=disabled
NOMI_STT_TIMEOUT_SECONDS=30
NOMI_TTS_TIMEOUT_SECONDS=30
NOMI_DEVICE_PROVIDER=null

# Frontend stage 2B config lives separately in frontend/.env.example.
# Never put LLM/speech credentials into VITE_* variables.
