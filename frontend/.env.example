# Public client configuration only. Restart Vite after edits.
# All production builds ignore api mode and force frontend mock.
VITE_CHAT_MODE=mock
VITE_API_BASE_URL=/api/v0
VITE_CHAT_TIMEOUT_MS=65000
# Vite server only: not included in the browser bundle; loopback only.
NOMI_DEV_BACKEND_URL=http://127.0.0.1:8000
# Never add LLM API keys, provider credentials or model configuration here.
