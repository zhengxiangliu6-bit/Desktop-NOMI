menu "Desktop-NOMI H2 local audio"
choice NOMI_WAKE_PROFILE
    prompt "Local audio/recognition profile"
    default NOMI_WAKE_AUDIO_ONLY
    config NOMI_WAKE_AUDIO_ONLY
        bool "Audio + AFE only; Xiaomi Tongxue unavailable"
    config NOMI_WAKE_BENCHMARK
        bool "BENCHMARK ONLY: Xiaoai Tongxue (not Xiaomi Tongxue)"
        select SR_WN_WN9_XIAOAITONGXUE
    config NOMI_VOICE_COMMANDS
        bool "Offline Chinese commands with configurable activation phrase (MultiNet7)"
        select SR_MN_CN_MULTINET7_QUANT
    config NOMI_WIFI_VOICE
        bool "BOOT button short recording with HTTPS transcription gateway"
    config NOMI_USB_ASR
        bool "USB microphone transport for Windows local Chinese transcription (no device ASR/actions)"
endchoice
config NOMI_VOICE_WAKE_LABEL
    string "Activation phrase display label"
    depends on NOMI_VOICE_COMMANDS
    default "小米同学"
config NOMI_VOICE_WAKE_PINYIN
    string "Activation phrase spoken pinyin (lowercase, space separated, no tones)"
    depends on NOMI_VOICE_COMMANDS
    default "xiao mi tong xue"
if NOMI_WIFI_VOICE
config NOMI_WIFI_SSID
    string "Wi-Fi SSID"
config NOMI_WIFI_PASSWORD
    string "Wi-Fi password"
config NOMI_WIFI_VOICE_URL
    string "HTTPS voice gateway URL including /device/voice"
config NOMI_WIFI_DEVICE_TOKEN
    string "Device gateway token"
endif
endmenu
